{
  "name": "@hv/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply hyperview-dev --local",
    "migrate:staging": "wrangler d1 migrations apply hyperview-staging --env staging --remote",
    "migrate:production": "wrangler d1 migrations apply hyperview --env production --remote"
  },
  "dependencies": {
    "@bt/data": "workspace:*",
    "@bt/schemas": "workspace:*",
    "@hv/schemas": "workspace:*",
    "@simplewebauthn/server": "^11.0.0",
    "@simplewebauthn/types": "^11.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260602.1",
    "typescript": "^5.6.3",
    "wrangler": "^3.95.0"
  }
}
