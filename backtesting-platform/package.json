{
  "name": "backtesting-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' build",
    "test": "pnpm -r --filter './packages/**' test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "ingest:hyperliquid": "tsx scripts/ingest-hyperliquid.ts",
    "ingest:kalshi": "tsx scripts/ingest-kalshi.ts",
    "ingest:brti": "tsx scripts/ingest-brti.ts",
    "seed:demo": "tsx scripts/seed-demo-run.ts",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "husky": "^9.1.6",
    "tsx": "^4.22.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9"
  }
}
