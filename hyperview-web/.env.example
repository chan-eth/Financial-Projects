# Upstream API base. Server-side only; never exposed to the browser.
#
# In production:  HYPERVIEW_API=https://api.hyperview.xyz
# Local with wrangler dev:  HYPERVIEW_API=http://localhost:8787
#
# Leave unset to fall back to talking directly to Hyperliquid testnet
# (handy for M0 demos before the worker is deployed).
#HYPERVIEW_API=
