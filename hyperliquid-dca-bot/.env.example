# ============================================================
# Hyperliquid DCA Bot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Coinbase Advanced Trade API ──────────────────────────────
# Create API keys at: https://www.coinbase.com/settings/api
# Required permissions: view, trade, transfer
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here

# ── EVM Wallet ───────────────────────────────────────────────
# The wallet that:
#   1. Receives USDC from Coinbase on Arbitrum
#   2. Executes the Across bridge deposit
#   3. Holds USDC on Hyperliquid for spot buys
#
# WARNING: Keep your private key secure. Never share it.
WALLET_PRIVATE_KEY=0xyour_private_key_here
ARBITRUM_WALLET_ADDRESS=0xyour_arbitrum_address_here

# ── RPC Endpoints ────────────────────────────────────────────
# Arbitrum One RPC — get a free key at:
#   https://www.alchemy.com  or  https://www.infura.io
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Hyperliquid EVM RPC
HYPERLIQUID_RPC_URL=https://rpc.hyperliquid.xyz/evm

# ── DCA Settings ─────────────────────────────────────────────
# Daily USDC amount to DCA (default: 25.0)
DAILY_USDC_AMOUNT=25.0

# Set to "true" to use Hyperliquid testnet (no real funds)
TESTNET=false
